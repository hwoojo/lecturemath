# Export these values in your shell or service configuration; .env is not loaded automatically.
BOARD_MODEL_PATH=/absolute/path/LectureNet_model_BIN_V34_final.dat
BOARD_DEVICE=cpu
BOARD_SAMPLING_FPS=1
BOARD_MAX_WIDTH=1280
BOARD_PDF_STYLE=smooth
BOARD_MAX_UPLOAD_MB=500
BOARD_MAX_DURATION=1800
BOARD_MAX_SAMPLES=1800
BOARD_THREADS=2
BOARD_JOBS_DIR=/absolute/path/jobs
BOARD_RETENTION_SECONDS=86400
BOARD_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
